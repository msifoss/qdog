generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model QueueEntry {
  id           Int      @id @default(autoincrement())
  customerName String
  email        String   @unique
  phone        String?
  sex          String   @default("male")  // "male" or "female"
  handle       String   @unique           // Public display name (e.g., "SteadyHawk42")
  avatar       String                     // Avatar path (e.g., "hawk" or "female/lioness")
  position     Int                        // Position in queue (1 = next up)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Settings {
  id                 Int     @id @default(1)
  businessName       String  @default("QDog")
  emailNotifications Boolean @default(true)
}
